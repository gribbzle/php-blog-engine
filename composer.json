{
    "name": "gribbzle/php-blog-engine",
    "description": "Simple PHP blog application with MySQL and Smarty",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smarty/smarty": "^4.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
